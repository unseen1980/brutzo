{
  "name": "brutzo-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-dsp.mjs && vite",
    "build": "node scripts/build-dsp.mjs && tsc -b && vite build && node scripts/verify-build.mjs",
    "dsp:format": "cargo fmt --manifest-path dsp/tone-core/Cargo.toml -- --check",
    "dsp:test": "cargo test --manifest-path dsp/tone-core/Cargo.toml",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
